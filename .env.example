SECRET_KEY=change-me-use-python-secrets-token-urlsafe-64
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=True
AUTH_COOKIE_SAMESITE=Lax
# Keep blank for safer host-only cookies (recommended).
AUTH_COOKIE_DOMAIN=

# Production example:
# DEBUG=False
# ALLOWED_HOSTS=payslippro.sbs,www.payslippro.sbs,api.payslippro.sbs
# CSRF_TRUSTED_ORIGINS=https://payslippro.sbs,https://www.payslippro.sbs,https://api.payslippro.sbs
# CORS_ALLOWED_ORIGINS=https://payslippro.sbs,https://www.payslippro.sbs
# CORS_ALLOW_ALL_ORIGINS=False
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# Enable these only after confirming every subdomain is HTTPS-only.
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Authentication throttling (Django cache-backed)
LOGIN_IP_RATE=20/min
LOGIN_ACCOUNT_RATE=5/min
PASSWORD_RESET_REQUEST_IP_RATE=10/hour
PASSWORD_RESET_REQUEST_ACCOUNT_RATE=3/hour
PASSWORD_RESET_VERIFY_IP_RATE=20/hour
PASSWORD_RESET_VERIFY_ACCOUNT_RATE=5/hour
LOGO_UPLOAD_RATE=20/hour
NUM_PROXIES=1
# Production defaults to a shared file cache.
# CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
# CACHE_LOCATION=/var/www/backend/.cache

# Logo upload validation
MAX_UPLOAD_SIZE=5242880
MAX_LOGO_DIMENSION=4096
MAX_LOGO_PIXELS=16000000

RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000
JWT_ISSUER=payslippro-api
JWT_AUDIENCE=payslippro-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
