# ==============================================================================
# PAYSLIP PRO - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Specifically optimized for Hostinger KVM 1 Plan (1 vCPU, 4GB RAM, Linux VPS)
# ==============================================================================
# INSTRUCTIONS:
# 1. On your VPS server, copy this file to: /var/www/payslippro/backend/.env
#    cp .env.production.example .env
# 2. Generate a secure 64-character SECRET_KEY using Python:
#    python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# 3. Replace 'yourdomain.com' with your actual domain or IP.
# 4. Set chmod 600 .env so only the deploy user and root can read it.
# ==============================================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=REPLACE_WITH_GENERATED_64_CHAR_SECRET_KEY_FROM_STEP_2

# Domain and Host Configurations (comma-separated, no spaces, no http://)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# PostgreSQL Database Connection URL (Local PostgreSQL running on Hostinger VPS)
# Format: postgresql://<db_user>:<db_password>@localhost:5432/<db_name>
DATABASE_URL=postgresql://payslip_user:STRONG_DATABASE_PASSWORD_HERE@localhost:5432/payslip_db

# CORS and CSRF Trusted Origins (Must be explicit https:// URLs)
FRONTEND_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False

# Cookie Security (Production requires HTTPS Secure cookies)
AUTH_COOKIE_SAMESITE=Lax
# Leave blank for host-only cookies (recommended unless frontend & api are on different subdomains)
AUTH_COOKIE_DOMAIN=

# Reverse Proxy / SSL (Nginx terminating SSL and forwarding to Gunicorn)
NUM_PROXIES=1

# JWT Token Lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=payslippro-api
JWT_AUDIENCE=payslippro-web

# Throttling / Rate-Limiting Protection (Against Brute Force & Abuse)
REGISTER_IP_RATE=10/hour
REGISTER_ACCOUNT_RATE=3/hour
LOGIN_IP_RATE=15/min
LOGIN_ACCOUNT_RATE=5/min
PASSWORD_RESET_REQUEST_IP_RATE=5/hour
PASSWORD_RESET_REQUEST_ACCOUNT_RATE=3/hour
PASSWORD_RESET_VERIFY_IP_RATE=10/hour
PASSWORD_RESET_VERIFY_ACCOUNT_RATE=5/hour
LOGO_UPLOAD_RATE=20/hour
EMAIL_SLIP_RATE=60/hour
AI_ASSISTANT_RATE=30/hour

# Upload & File Limits
UPLOAD_DIR=/var/www/payslippro/backend/uploads
MAX_UPLOAD_SIZE=5242880
MAX_LOGO_DIMENSION=4096
MAX_LOGO_PIXELS=16000000

# SMTP Email Delivery (Gmail / Brevo / Sendgrid)
# Note: For Gmail, use an "App Password" generated in Google Account Security, NOT your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_google_app_password

# Google OAuth 2.0 (Optional: for one-tap sign-in)
# Obtain from Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/auth/google/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# Razorpay Payment Gateway (Live credentials from Razorpay Dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI Assistant (Hermes Agent / Gemini / OpenAI)
# Hermes AI Agent on VPS (port 8642):
AI_BASE_URL=http://127.0.0.1:8642/v1/chat/completions
AI_API_KEY=f38cd8bbfe4460bc01d3f7324b0d8d86be5f7265503b06da390fb89216e2f625
AI_MODEL=gpt-4o
# Cloud AI Fallbacks (Optional):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Sentry Error Monitoring & Crash Tracking (Optional: free tier at sentry.io)
# Paste your Sentry DSN URL here to automatically receive alerts on any unhandled 500 error
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ENVIRONMENT=production
